{
  "name": "pipecad-project-merge",
  "productName": "PipeCAD Project Merge",
  "version": "0.0.1",
  "appRevision": "00.00.001",
  "description": "Combine several PipeCAD .pl project files into one, with the design unchanged.",
  "author": "Brent",
  "private": true,
  "main": "main.js",
  "scripts": {
    "prepare-app": "node scripts/prepare.js",
    "start": "npm run prepare-app && electron .",
    "dist": "npm run prepare-app && node scripts/dist.js"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.github.thebmgatkgs.pipecadprojectmerge",
    "productName": "PipeCAD Project Merge",
    "files": [
      "main.js",
      "app/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PipeCAD Project Merge"
    }
  }
}
